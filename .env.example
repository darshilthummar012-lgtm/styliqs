# Amazon Creators API (server-only — never commit real secrets)
# Get these from Amazon Associates Creators API onboarding

AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=

# Your Associates partner tag for India (e.g. yoursite-21)
AMAZON_PARTNER_TAG=

# Marketplace host for India
AMAZON_MARKETPLACE=www.amazon.in

# Token endpoint region for India credentials (EU):
# https://api.amazon.co.uk/auth/o2/token
AMAZON_TOKEN_URL=https://api.amazon.co.uk/auth/o2/token

# Optional: set to "true" to force live API when credentials exist
AMAZON_LIVE_CATALOG=true
